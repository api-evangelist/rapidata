      "item": [
        {
          "id": "98d8a5cf-34c0-4971-98d9-a9a5ae60b6c8",
          "name": "Gets the anchor rapid and its surrounding rapids within the results slice, in the order\n and filter the results grid renders, so the explorer can step neighbour-to-neighbour.",
          "request": {
            "name": "Gets the anchor rapid and its surrounding rapids within the results slice, in the order\n and filter the results grid renders, so the explorer can step neighbour-to-neighbour.",
            "description": {
              "content": "Navigation follows the grid's default order (flagged rapids first, then by id) over the\n given correlation slice. Returns 404 when the rapid is not part of the filtered slice.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rapid",
                ":rapidId",
                "navigation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "correlationId",
                  "value": "<string>",
                  "description": "(Required) The correlation id whose result slice to navigate."
                },
                {
                  "disabled": false,
                  "key": "states",
                  "value": "<string>",
                  "description": "Optional rapid states to filter by; all states are included when omitted."
                },
                {
                  "disabled": false,
                  "key": "states",
                  "value": "<string>",
                  "description": "Optional rapid states to filter by; all states are included when omitted."
                },
                {
                  "disabled": false,
                  "key": "window",
                  "value": "3",
                  "description": "The maximum number of neighbours to return on each side."
                },
                {
                  "disabled": false,
                  "key": "includeNotAccepted",
                  "value": "false",
                  "description": "When true, not-accepted responses count toward the anchor's sample and aggregation."
                },
                {
                  "disabled": false,
                  "key": "includeOverflow",
                  "value": "false",
                  "description": "When true, overflow responses count toward the anchor's sample and aggregation."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "rapidId",
                  "description": "(Required) The rapid to anchor navigation on."
                }
              ]
